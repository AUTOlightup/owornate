<?xml version="1.0" encoding="utf-8"?>
<!-- Replaceable skin v1. Content canvas: 181dp x at least 100dp, no host margins. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="100dp" android:orientation="vertical"
    android:padding="10dp" android:background="@drawable/owornate_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="OWOrnate" android:textSize="16sp"
            android:textStyle="bold" android:textColor="#F0F3FA" android:maxLines="1" />
        <TextView android:id="@+id/widget_version" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#A4AEC0"
            android:layout_marginStart="4dp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:text="莫奈 · 状态待确认" android:textSize="12sp" android:textColor="#EBC16C" />
    <TextView android:id="@+id/widget_theme" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="打开组件读取状态"
        android:textSize="10sp" android:textColor="#A4AEC0" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:text="点按编辑" android:textSize="9sp" android:textColor="#A4AEC0" />
</LinearLayout>
