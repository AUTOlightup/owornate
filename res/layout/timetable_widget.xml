<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timetable_root" android:layout_width="match_parent" android:layout_height="100dp"
    android:background="@drawable/timetable_bg_today">
    <FrameLayout android:id="@+id/timetable_content" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical">
            <TextView android:id="@+id/timetable_label" android:layout_width="wrap_content" android:layout_height="16dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:gravity="center" android:includeFontPadding="false" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:background="@drawable/timetable_pill_today" />
            <TextView android:id="@+id/timetable_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="end|center_vertical" android:includeFontPadding="false" android:textSize="12sp" android:textColor="#ABABB2" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/timetable_name" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="31dp" android:includeFontPadding="false" android:gravity="center_vertical" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="#F2F2F4" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/timetable_name_long" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="31dp" android:includeFontPadding="false" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="#F2F2F4" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/timetable_details" android:layout_width="match_parent" android:layout_height="15dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="56dp" android:includeFontPadding="false" android:textSize="12sp" android:textColor="#ABABB2" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/timetable_details_long" android:layout_width="match_parent" android:layout_height="17dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="73dp" android:includeFontPadding="false" android:textSize="12sp" android:textColor="#ABABB2" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/timetable_line" android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="76dp" android:background="#1AFFFFFF" />
        <TextView android:id="@+id/timetable_footer" android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="80dp" android:includeFontPadding="false" android:textSize="11sp" android:textColor="#ABABB2" android:maxLines="1" android:ellipsize="end" />
    </FrameLayout>
    <LinearLayout android:id="@+id/timetable_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp">
        <TextView android:layout_width="match_parent" android:layout_height="15dp" android:text="课表" android:textSize="12sp" android:textColor="#ABABB2" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
        <TextView android:id="@+id/timetable_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="尚未导入课表" android:textSize="14sp" android:textColor="#F2F2F4" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/timetable_empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点按导入课程" android:textSize="11sp" android:textColor="#8AD8FB" />
    </LinearLayout>
</FrameLayout>
