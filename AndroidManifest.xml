<?xml version="1.0" encoding="utf-8"?>
<!--
  OWOrnate - 手表侧原生管理器
  包名 dev.codex.watchworkshop / minSdk 26 / targetSdk 27 / compileSdk 35
  版本号只在这里维护（versionCode / versionName），build.ps1 和 make-release.ps1 都从这里读。

  安全边界（本轮刻意保持最小暴露面）：
  - 申请 INTERNET、RECEIVE_BOOT_COMPLETED、WAKE_LOCK 和 PACKAGE_USAGE_STATS；
    录屏期间使用有限时亮屏锁，不额外申请存储或音频权限，文件由已有 root 通道写入。
    PACKAGE_USAGE_STATS 只在倒计时切到纪念日模式时经本机 root 授予（appops），切回时撤回；
    只用来判断快应用引擎是否到过前台，从而决定亮屏时要不要重读纪念日。
  - 只有一个带 LAUNCHER 入口的 Activity；三个小组件设置页只响应 APPWIDGET_CONFIGURE。
  - 纪念日模式只读系统快应用“纪念日”的数据文件，用固定命令读取，从不写入。
  - RuntimeBootReceiver 只处理 BOOT_COMPLETED 与 MY_PACKAGE_REPLACED，且只在已有本包
    独立目录时做一次 ensure，不执行任意 shell、不创建缺失目录、不接管生产组件。
  - RuntimeAccessibility 由独立安装流程启用，兼容模式不启用；构建只打包。
    它只处理 Launcher 事件，不读取窗口内容；只有持有 BIND_ACCESSIBILITY_SERVICE 的系统
    能绑定它，不监听端口、不导出调试入口。
  - CaptureEntryActivity 只允许持有 STATUS_BAR 的系统端（Launcher / system uid）与本包调用；
    它只接受截图/录屏短按与打开对应设置四个固定动作，不接收 shell。模块页、设置和服务均不导出。
  - CaptureService 只在用户截屏/录屏期间前台运行，无开机录制或常驻录制服务。
  - 不声明或替换任何 Bootstrap 组件，不与 watchhide bootstrap 共用组件名或权限。
  - 不在构建阶段安装或连接设备，APK 只落到 dist 目录。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.codex.watchworkshop"
    android:versionCode="18"
    android:versionName="1.0.1-rc9">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="27" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 仅用户录屏期间保持 Android 屏幕亮起；结束或进程退出即释放。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 系统级权限，普通安装拿不到；纪念日模式下由管理器经 root 用 appops 授予。 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:name="dev.codex.watchworkshop.WorkshopApp"
        android:allowBackup="false"
        android:debuggable="false"
        android:icon="@drawable/ic_launcher"
        android:label="OWOrnate"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 桌面启动入口。 exported 仅服务于 LAUNCHER，不做命令行入口。 -->
        <activity
            android:name="dev.codex.watchworkshop.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:label="OWOrnate"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="dev.codex.watchworkshop.CaptureEntryActivity"
            android:exported="true" android:permission="android.permission.STATUS_BAR"
            android:taskAffinity="dev.codex.watchworkshop.capture.entry"
            android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@style/CaptureEntryTheme" />
        <activity android:name="dev.codex.watchworkshop.CaptureOptionsActivity"
            android:exported="false" android:taskAffinity="dev.codex.watchworkshop.capture.options"
            android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@style/AppTheme" />
        <service android:name="dev.codex.watchworkshop.CaptureService" android:exported="false" />
        <activity android:name="dev.codex.watchworkshop.CaptureSetupActivity"
            android:exported="false" android:theme="@style/AppTheme" />
        <activity android:name="dev.codex.watchworkshop.CaptureScreenshotActivity"
            android:exported="false" android:taskAffinity="dev.codex.watchworkshop.capture.screenshot"
            android:excludeFromRecents="true" android:theme="@style/AppTheme" />

        <activity
            android:name="dev.codex.watchworkshop.OWOrnateWidgetSettingsActivity"
            android:exported="true" android:label="OWOrnate 小组件"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Only the system may dispatch widget lifecycle events; rendering is cache-only. -->
        <receiver android:name="dev.codex.watchworkshop.OWOrnateWidgetProvider"
            android:exported="true" android:label="OWOrnate 信息"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/owornate_widget_info" />
        </receiver>

        <activity android:name="dev.codex.watchworkshop.CountdownSettingsActivity" android:exported="true" android:label="倒计时设置" android:theme="@style/AppTheme">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name="dev.codex.watchworkshop.TimetableSettingsActivity" android:exported="true" android:label="课表" android:theme="@style/AppTheme">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- 纪念日模式下点倒计时卡片：打开纪念日后立刻结束，不显示界面；只由本应用的卡片点击启动。 -->
        <activity android:name="dev.codex.watchworkshop.AnniversaryLaunchActivity"
            android:exported="false" android:excludeFromRecents="true" android:noHistory="true"
            android:taskAffinity="" android:theme="@android:style/Theme.NoDisplay" />
        <receiver android:name="dev.codex.watchworkshop.CountdownWidgetProvider" android:exported="true" android:label="倒计时" android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/countdown_widget_info" />
        </receiver>
        <receiver android:name="dev.codex.watchworkshop.TimetableWidgetProvider" android:exported="true" android:label="课表" android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/timetable_widget_info" />
        </receiver>
        <receiver android:name="dev.codex.watchworkshop.WidgetClock" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          受控启动检查：只处理开机完成与本次安装/更新完成两个合法广播。
          只做一次本包自有目录 ensure；没有现成本包独立目录时不创建、不接管任何生产组件，
          也不执行任意 shell。
        -->
        <receiver
            android:name="dev.codex.watchworkshop.RuntimeBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          无障碍服务：只有用户在系统设置里手动开启后才会被系统绑定。
          只处理 Launcher 事件，不读取窗口内容；这里只声明能力，
          不 enable、不自动授予、不做后台常驻。
        -->
        <service
            android:name="dev.codex.watchworkshop.RuntimeAccessibility"
            android:exported="true"
            android:label="OWOrnate"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/runtime_accessibility" />
        </service>
    </application>

</manifest>
